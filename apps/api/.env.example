# Postgres. Inside docker compose the host is `db`; locally it is `localhost`.
DATABASE_URL="postgresql://katapatha:katapatha@localhost:5432/katapatha?schema=public"

# Where the competition CSVs live. If this folder holds the expected files the
# seeder uses the REAL data; otherwise it falls back to the committed synthetic
# fixture. See prisma/seed/source.ts.
# DATA_DIR="../../../katapatha-project/data"

# Set to 1 to force a re-seed even when SeedMeta says the DB is already seeded.
# SEED_FORCE=1

# Expose the temporary local review accounts. Keep off in production.
# ALLOW_DEMO_ACCESS=0

PORT=3001
NODE_ENV=development
