enum Brand {
  Fresh
  Style
  Tech
}

/// What an ORDER needs. Distinct from VehicleTemp on purpose. `frozen` is ours,
/// not the competition's: it needs a reefer exactly as `chilled` does.
enum TempRequirement {
  chilled
  frozen
  ambient
}

/// What a VEHICLE can do. A reefer may carry any; ambient may carry only ambient.
enum VehicleTemp {
  reefer
  ambient
}

enum VehicleType {
  truck
  van
}

enum DockType {
  rear_dock
  street
  mall_bay
}

enum ParkingConstraint {
