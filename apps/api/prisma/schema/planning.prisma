// ==========================================================================
// planning.prisma
//
// Order intake through allocation and publication. Owner: BE2.
// ==========================================================================

/// The artefact of "close orders": one queue per depot per day.
model PlanningDay {
  id               String            @id @default(cuid())
  date             DateTime          @db.Date
  depotCode        String
  status           PlanningDayStatus @default(OPEN)
  cutoffAt         String            @default("16:00")
  closedAt         DateTime?
  closedByUserId   String?
  queueSnapshot    Json?

  plans Plan[]

  @@unique([date, depotCode])
  @@index([status])
}

model Order {
  id                  String          @id @default(cuid())
  /// Allocation key. Matches order_ref in the organisers' submission CSV.
  ref                 String
  outletId            String
  outlet              Outlet          @relation(fields: [outletId], references: [id])
  brand               Brand
  districtName        String
  depotCode           String
  tempRequirement     TempRequirement
  units               Int
  weightKg            Float
  volumeM3            Float
  windowOpen          String
  windowClose         String
  requestedDate       DateTime        @db.Date
  placedAt            DateTime        @default(now())
  placedByUserId      String?
  status              OrderStatus     @default(PLACED)
  /// Fairness signals. Supplied in the peak-day scenario, derived elsewhere.
  deferredYesterday   Boolean         @default(false)
  daysSinceLastServed Int             @default(1)
  rolledFromOrderId   String?
  /// Idempotency key for order placement from a flaky connection.
  clientRequestId     String?         @unique

  assignments  Assignment[]
  tripStopLinks TripStopOrder[]
  deferrals    Deferral[]
  loadChecks   LoadCheck[]
  loadProgress LoadProgress[]
  shortfalls   Shortfall[]
  stopEvents   StopEvent[]
  problems     Problem[]
  receipt      ReceiptConfirmation?
  /// What is in the order, when it was placed from products. Empty for the
  /// competition's orders and for legacy unit-only orders: the order's own
  /// units/weight/volume are the allocation truth either way.
  lines        OrderLine[]

  /// One decision per order per day. Also the dispatcher queue's hot path.
  @@unique([ref, requestedDate])
  @@index([requestedDate, depotCode, status])
  @@index([outletId, requestedDate])
  @@index([status])
}

/// The catalogue a store orders from. Waypoint-wide, not per depot.
///
/// There is deliberately no stock or price here: nothing in this system knows
/// what a depot holds or what anything costs, so the catalogue answers "what
/// can be ordered", never "what is available". Products are deactivated, never
/// deleted, because order lines keep pointing at them.
model Product {
  id              String          @id @default(cuid())
  /// Immutable once created; upper-case. Order lines snapshot it anyway.
  sku             String          @unique
  name            String
  /// Null = every brand. A store sees its own outlet's brand plus these.
  brand           Brand?
  tempRequirement TempRequirement
  unitLabel       String
  kgPerUnit       Float
  m3PerUnit       Float
  active          Boolean         @default(true)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdByUserId String?

  orderLines OrderLine[]

  /// The store's picker: active products in display order.
  @@index([active, sortOrder])
  @@index([brand])
}

/// One product's quantity within an order. sku, name, unit label and size are
/// copied from the product at placement, so renaming or re-sizing a product
/// never rewrites what a past order contained (or its weight and volume).
model OrderLine {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  sku         String
  productName String
  unitLabel   String
  kgPerUnit   Float
  m3PerUnit   Float
  quantity    Int

  @@unique([orderId, productId])
  @@index([orderId])
}

model Plan {
  id                String      @id @default(cuid())
  planningDayId     String
  planningDay       PlanningDay @relation(fields: [planningDayId], references: [id], onDelete: Cascade)
  status            PlanStatus  @default(DRAFT)
  createdByUserId   String?
  createdAt         DateTime    @default(now())
  publishedAt       DateTime?
  publishedByUserId String?
  allocatorVersion  String?
  objectiveSummary  Json?

  trips       Trip[]
  assignments Assignment[]
  deferrals   Deferral[]

  @@index([planningDayId, status])
}

model Trip {
  id                String     @id @default(cuid())
  planId            String
  plan              Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  vehicleId         String
  vehicle           Vehicle    @relation(fields: [vehicleId], references: [id])
  /// 1 or 2. The organisers' trip_id.
  tripNo            Int
  brand             Brand
  districtName      String
  wave              Wave
  plannedDepartAt   String
  plannedMinutes    Float
  plannedDistanceKm Float
  plannedFuelL      Float
  sumWeightKg       Float
  sumVolumeM3       Float
  status            TripStatus @default(PLANNED)
  loadConfirmedAt   DateTime?
  /// The dock bay this trip loads at, 1..Depot.dockBays. Filled the first time
  /// the dock reads a published day, then kept, so a bay never moves under a
  /// loader.
  dockBay           Int?
  /// The first load check or in-progress count on this trip. With
  /// loadConfirmedAt (the seal) it gives the load time.
  loadStartedAt     DateTime?
  departedAt        DateTime?
  completedAt       DateTime?

  stops             TripStop[]
  loadChecks        LoadCheck[]
  loadProgress      LoadProgress[]
  vehicleSwaps      VehicleSwap[]
  shortfalls        Shortfall[]
  problems          Problem[]
  fromReassignments StopReassignment[] @relation("ReassignFrom")
  toReassignments   StopReassignment[] @relation("ReassignTo")
  fuelEntries       FuelLedgerEntry[]
  pings             VehiclePing[]
  chillerReadings   ChillerReading[]

  /// Enforces rule 7 (at most two trips a day) in the database, not just in code.
  @@unique([planId, vehicleId, tripNo])
  @@index([planId])
  @@index([vehicleId, status])
}

model TripStop {
  id               String     @id @default(cuid())
  tripId           String
  trip             Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seq              Int
  outletId         String
  outlet           Outlet     @relation(fields: [outletId], references: [id])
  status           StopStatus @default(PENDING)
  plannedArrivalAt String
  etaAt            String?
  arrivedAt        DateTime?
  leftAt           DateTime?
  chillerReadings ChillerReading[]

  orders        TripStopOrder[]
  assignments   Assignment[]
  stopEvents    StopEvent[]
  problems      Problem[]
  reassignments StopReassignment[]

  @@unique([tripId, seq])
  @@index([outletId])
}

/// Join table: one stop may deliver several orders (a Fresh outlet routinely
/// takes a dry order and a chilled order on the same day).
model TripStopOrder {
  tripStopId String
  tripStop   TripStop @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([tripStopId, orderId])
  @@index([orderId])
}

/// One row per order per plan — this maps 1:1 to a line of the organisers'
/// submission CSV, and the unique index is the guarantee that every order is
/// decided exactly once.
model Assignment {
  id          String    @id @default(cuid())
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tripStopId  String?
  tripStop    TripStop? @relation(fields: [tripStopId], references: [id])
  decision    Decision
  reasonCode  String?
  /// The dispatcher's own note on a deferral, copied to Deferral.note at publish.
  note        String?
  /// The allocator's machine-derived cause: binding constraint, near miss,
  /// and what would have made the order fit.
  explanation Json?
  createdAt   DateTime  @default(now())

  @@unique([planId, orderId])
  @@index([tripStopId])
  @@index([planId, decision])
}

model Deferral {
  id              String    @id @default(cuid())
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reasonCode      String
  note            String?
  rolledToDate    DateTime? @db.Date
  decidedByUserId String?
  decidedAt       DateTime  @default(now())
  storeNotifiedAt DateTime?
  acknowledgedAt  DateTime?

  @@unique([planId, orderId])
  @@index([orderId])
}
