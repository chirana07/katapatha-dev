// ==========================================================================
// ledger.prisma
//
// Fuel, capacity actions, sync log, seed metadata. Owner: BE3.
// ==========================================================================

model FuelLedger {
  id          String  @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])
  isoYear     Int
  isoWeek     Int
  quotaL      Float
  committedL  Float   @default(0)
  consumedL   Float   @default(0)

  entries FuelLedgerEntry[]

  @@unique([vehicleId, isoYear, isoWeek])
  @@index([isoYear, isoWeek])
}

/// Append-only, so the weekly fuel number is auditable rather than asserted.
model FuelLedgerEntry {
  id        String        @id @default(cuid())
  ledgerId  String
  ledger    FuelLedger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  tripId    String?
  trip      Trip?         @relation(fields: [tripId], references: [id])
  km        Float
  litres    Float
  kind      FuelEntryKind
  note      String?
  createdAt DateTime      @default(now())

  @@index([ledgerId])
  @@index([tripId])
}

/// The forecast's actionable output: a predicted deficit becomes a decision.
model CapacityAction {
  id              String               @id @default(cuid())
  isoYear         Int
  isoWeek         Int
  depotCode       String
  brand           Brand?
  kind            CapacityActionKind
  params          Json?
  expectedRelief  Json?
  status          CapacityActionStatus @default(PROPOSED)
  decidedByUserId String?
  decidedAt       DateTime?
  reasonCode      String?
  note            String?
  appliesFromDate DateTime?            @db.Date
  createdAt       DateTime             @default(now())

  @@index([depotCode, isoYear, isoWeek])
  @@index([status])
}

/// Makes the offline story visible: batch sizes, duplicates, conflicts, skew.
model SyncLog {
  id          String   @id @default(cuid())
  deviceId    String
  userId      String?
  receivedAt  DateTime @default(now())
  batchSize   Int
  accepted    Int
  duplicates  Int
  conflicts   Int
  clockSkewMs Int

  @@index([deviceId, receivedAt])
}

/// Seed idempotency. The checksum means switching from the synthetic fixture
/// to the real data triggers a re-seed automatically.
model SeedMeta {
  key        String   @id
  version    String
  dataSource String
  checksum   String
  seededAt   DateTime @default(now())
}
