{
  "name": "@katapatha/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:seed:products": "tsx prisma/seed/productsOnly.ts",
    "db:validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@fastify/autoload": "6.5.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@katapatha/allocator": "workspace:*",
    "@katapatha/core": "workspace:*",
    "@prisma/client": "6.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.1.3",
    "prisma": "6.12.0",
    "tsx": "4.23.15",
    "vitest": "5.0.2"
  }
}
