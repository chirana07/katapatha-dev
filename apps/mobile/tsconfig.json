{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    // DOM is here for the web-shaped globals React Native does provide (fetch,
    // URL, AbortController, Crypto). node is for node:sqlite, which backs the
    // outbox tests -- expo-sqlite is a native module and cannot run under Node,
    // so the tests drive the same SQL through a different binding.
    "lib": ["DOM", "ES2022"],
    "types": ["node", "react"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "*.ts"]
}
